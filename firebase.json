{
  "functions": {
    "source": "functions",
    "codebase": "barflow-api",
    "runtime": "python312",
    "predeploy": [
      "bash \"$RESOURCE_DIR/vendor-backend.sh\""
    ],
    "ignore": [
      "venv",
      ".venv",
      ".git",
      ".env",
      ".env.*",
      "firebase-debug.log",
      "firebase-debug.*.log",
      "**/__pycache__/**",
      "**/*.py[cod]",
      "**/.pytest_cache/**",
      "**/.mypy_cache/**",
      "**/.DS_Store"
    ]
  },
  "hosting": {
    "public": "frontend/build",
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
    "rewrites": [
      {
        "source": "/api/**",
        "function": {
          "functionId": "api",
          "region": "asia-south1"
        }
      },
      {
        "source": "**",
        "destination": "/index.html"
      }
    ],
    "headers": [
      {
        "source": "/static/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=31536000, immutable"
          }
        ]
      },
      {
        "source": "/index.html",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, no-store, must-revalidate"
          }
        ]
      }
    ]
  }
}
