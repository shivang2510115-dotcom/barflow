# dependencies
node_modules/
.pnp
.pnp.js

# builds
build/
dist/
*.egg-info/

# python
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
venv/
.venv/

# secrets — never commit these
.env
.env.*
!.env.example

# local mock datastore: holds password hashes and throwaway demo trade
backend/db.json

# os / editor
.DS_Store
*.swp
.idea/
.vscode/

# logs
*.log
npm-debug.log*
yarn-error.log*
.superpowers/
.deploy-secrets

# generated by functions/vendor-backend.sh at deploy time: backend/ copied into the
# functions source directory so the Firebase CLI uploads it. Never edit it, never commit
# it — backend/ is the only version under review and the next deploy overwrites this.
functions/backend/
functions/venv

# local stand-ins for the Secret Manager values, read by the Functions emulator.
# Same contents as the real secrets; never committed.
functions/.secret.local
table-qr-codes.pdf
room-qr-codes.pdf
