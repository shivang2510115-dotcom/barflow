# react-day-picker@8 declares a peer of date-fns ^2 || ^3, but this project uses
# date-fns 4. The combination works — react-day-picker only uses date-fns APIs that
# are unchanged in 4 — but strict peer resolution refuses to install it.
#
# This lives here rather than as a --legacy-peer-deps flag on one build command so a
# fresh `npm ci` and a local `npm install` behave identically. Without it, Render's
# `npm ci` fails outright while a developer's machine installs fine, which is exactly
# the kind of divergence that only shows up in a deploy.
legacy-peer-deps=true
