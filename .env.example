# Backend — copy to backend/.env for local dev, or set these in the Render dashboard.
# Nothing here is a real secret; every value is a placeholder.

# Which database. Three answers:
#
#   mock        a JSON file at backend/db.json. The default, and all a fresh clone needs
#               — no database to install, no account to open. `npm start` and go.
#   firestore   the Firebase project's own Firestore. What deploys; see deploy.sh, which
#               sets it for you. No connection string: the function's service account is
#               the credential and the project is read from the metadata server.
#   mongo       MongoDB at MONGO_URL below.
#
# Left unset, MONGO_URL decides on its own the way it always has: "mock", "local" or
# absent gives the JSON file, anything else is treated as a MongoDB URL.
DB_BACKEND=mock

# Only read when the backend is mongo.
MONGO_URL=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
DB_NAME=barflow

# Sign the login tokens. Any long random string. Changing it logs everyone out.
JWT_SECRET=generate-a-long-random-string

# The one account seeded on a fresh database.
ADMIN_EMAIL=you@yourbar.com
ADMIN_PASSWORD=set-a-real-password

# Keep "false" anywhere reachable from the internet: "true" seeds manager/waiter/kitchen
# accounts whose passwords are published in this repo.
DEMO_LOGINS=false

# Full origin of the site, with scheme. Never "*" — this API sends credentials.
CORS_ORIGINS=https://your-site.onrender.com

CURRENCY_SYMBOL=₹

# WhatsApp brief. Left off, the brief still renders in the app and only logs on send.
DAILY_BRIEF_ENABLED=false
OWNER_BRIEF_TIME=23:00
OWNER_PHONE=
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=

STRIPE_API_KEY=

# Frontend — set in the static site's build environment, not here.
# Compile-time: changing it needs a rebuild, not a restart.
# REACT_APP_BACKEND_URL=https://your-api.onrender.com
